{
  "name": "ffsd-project",
  "version": "1.0.0",
  "main": "script.js",
  "scripts": {
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --ci",
    "test:report": "npm run test:coverage",
    "build:client": "npm --prefix client install && npm --prefix client run build",
    "build": "npm run build:client",
    "start": "node server.js",
    "docker:build": "docker build -t ffsd-project:latest .",
    "docker:run": "docker run --rm -p 3000:3000 --env-file .env ffsd-project:latest",
    "docker:compose": "docker compose up --build",
    "docker:compose:dev": "docker compose -f docker-compose.dev.yml up --build",
    "perf:db": "node scripts/dbPerfReport.js",
    "perf:db:compare": "node scripts/dbPerfCompare.js",
    "perf:cache": "node scripts/cachePerfReport.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "adm-zip": "^0.5.16",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-graphql": "^0.12.0",
    "express-session": "^1.18.2",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.7.0",
    "graphql": "^15.10.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.13.0",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.3",
    "pdfkit": "^0.17.2",
    "redis": "^4.7.1",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7",
    "stripe": "^20.3.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^30.0.5",
    "jest-junit": "^16.0.0"
  }
}
